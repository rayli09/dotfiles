tap "homebrew/bundle"

# Dotfiles / Git
brew "chezmoi"
brew "git"
brew "git-lfs"
brew "gh"

# Shell / navigation
brew "bat"
brew "coreutils"
brew "direnv"
brew "eza"
brew "fd"
brew "fzf"
brew "jq"
brew "lazygit"
brew "mise"
brew "ripgrep"
brew "shfmt"
brew "shellcheck"
brew "starship"
brew "tmux"
brew "tokei"
brew "tree"
brew "zoxide"

# Runtimes / package managers (Node, Python, and Go are managed by mise)
brew "bun"
brew "deno"
brew "pnpm"
brew "rustup"
brew "uv"

# Cloud / containers / build tooling
brew "cloudflared"
brew "docker"
brew "gnupg"
brew "hyperfine"
brew "mas"
brew "openssl@3"
brew "pkg-config"
brew "watchman"

# HTTP / network
brew "curl"
brew "httpie"
brew "wget"
brew "xh"

cask "1password"
cask "1password-cli"
cask "cursor"
cask "discord"
cask "figma"
cask "ghostty"
cask "google-chrome"
cask "iterm2"
cask "linear-linear"
cask "notion"
cask "obsidian"
cask "orbstack"
cask "postman"
cask "raycast"
cask "rectangle"
cask "slack"
cask "tableplus"
cask "visual-studio-code"
cask "zoom"
cask "font-source-code-pro"
