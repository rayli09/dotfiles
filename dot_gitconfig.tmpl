[user]
	name = {{ .git_name | quote }}
	email = {{ .git_email | quote }}

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[core]
{{ if eq .chezmoi.os "darwin" }}	editor = code --wait
{{ else }}	editor = vi
{{ end }}
	excludesfile = ~/.gitignore_global

{{ if eq .chezmoi.os "darwin" }}
[credential]
	helper = osxkeychain
{{ end }}

