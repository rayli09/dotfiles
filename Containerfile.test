FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    libatomic1 \
    xz-utils \
    shellcheck \
  && rm -rf /var/lib/apt/lists/*

RUN sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b /usr/local/bin

WORKDIR /work
COPY . /work

CMD ["bash", "-c", "bash scripts/check.sh && bash scripts/install-tools.sh && bash scripts/test-scripts.sh && bash scripts/test-skills.sh"]
